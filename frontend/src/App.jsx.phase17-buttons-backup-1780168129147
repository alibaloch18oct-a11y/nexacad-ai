export default function App() {
  const [backendStatus, setBackendStatus] = useState("checking");
  const [prompt, setPrompt] = useState(SAMPLE_PROMPT);
  const [aiCommand, setAiCommand] = useState("");
  const [plan, setPlan] = useState(null);
  const [projects, setProjects] = useState([]);
  const [activeFloor, setActiveFloor] = useState(0);
  const [selected, setSelected] = useState(null);
  const [activeTool, setActiveTool] = useState("select");
  const [viewMode, setViewMode] = useState("dashboard");
  const [planMode, setPlanMode] = useState("architectural");
  const [zoom, setZoom] = useState(1);
  const [stagePosition, setStagePosition] = useState({ x: 0, y: 0 });
  const [history, setHistory] = useState([]);
  const [future, setFuture] = useState([]);
  const [loading, setLoading] = useState(false);
  const [commandLoading, setCommandLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [autosaveStatus, setAutosaveStatus] = useState("No autosave loaded");
  const [fullscreenStudio, setFullscreenStudio] = useState(false);

  const stageRef = useRef(null);

  useEffect(() => {
    checkBackend();
    loadProjects();
    restoreAutosave();
  }, []);

  useEffect(() => {
    if (!plan) return;

    const timer = setTimeout(() => {
      try {
        localStorage.setItem(
          AUTOSAVE_KEY,
          JSON.stringify({
            plan: normalizePlan(plan),
            activeFloor,
            viewMode,
            savedAt: new Date().toISOString()
          })
        );

        setAutosaveStatus(`Autosaved ${new Date().toLocaleTimeString()}`);
      } catch {
        setAutosaveStatus("Autosave failed");
      }
    }, 700);

    return () => clearTimeout(timer);
  }, [plan, activeFloor, viewMode]);

  useEffect(() => {
    function onKeyDown(event) {
      if (event.key === "Delete" || event.key === "Backspace") {
        const tag = document.activeElement?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select") return;
        deleteSelected();
      }

      if (event.ctrlKey && event.key.toLowerCase() === "z") {
        event.preventDefault();
        undo();
      }

      if (event.ctrlKey && event.key.toLowerCase() === "y") {
        event.preventDefault();
        redo();
      }

      if (event.key === "Escape") {
        setActiveTool("select");
        setSelected(null);
        setFullscreenStudio(false);
      }

      if (event.key === "F11") {
        event.preventDefault();
        setFullscreenStudio((value) => !value);
      }
    }

    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  });

  const collisionWarnings = useMemo(() => detectCollisionWarnings(plan), [plan]);

  const stats = useMemo(() => {
    if (!plan) {
      return {
        plot: "-",
        floors: "-",
        rooms: "-",
        layers: "-",
        floorArea: 0
      };
    }

    const currentFloorRooms = plan.rooms.filter((room) => room.floor === activeFloor);
    const currentFloorArea = currentFloorRooms.reduce((sum, room) => {
      const width = Math.round(room.width / plan.scale);
      const height = Math.round(room.height / plan.scale);
      return sum + width * height;
    }, 0);

    return {
      plot: `${plan.plot.width} x ${plan.plot.length} ft`,
      floors: plan.floors,
      rooms: plan.rooms.length,
      layers: plan.layers?.length || 0,
      floorArea: currentFloorArea
    };
  }, [plan, activeFloor]);

  const selectedLabel = useMemo(() => resolveSelectedLabel(plan, selected), [plan, selected]);

  function restoreAutosave() {
    try {
      const raw = localStorage.getItem(AUTOSAVE_KEY);
      if (!raw) return;

      const data = JSON.parse(raw);
      if (!data?.plan) return;

      const ok = window.confirm(
        "NexaCAD found an autosaved project. Do you want to restore it?"
      );

      if (!ok) return;

      setPlan(normalizePlan(data.plan));
      setActiveFloor(data.activeFloor || 0);
      setViewMode(data.viewMode === "dashboard" ? "2d" : data.viewMode || "2d");
      setAutosaveStatus("Autosave restored");
    } catch {
      setAutosaveStatus("Autosave restore failed");
    }
  }

  function clearAutosave() {
    localStorage.removeItem(AUTOSAVE_KEY);
    setAutosaveStatus("Autosave cleared");
    alert("Autosave cleared.");
  }

  async function checkBackend() {
    try {
      const res = await axios.get(`${API_URL}/api/health`);
      setBackendStatus(res.data.ok ? "online" : "offline");
    } catch {
      setBackendStatus("offline");
    }
  }

  async function loadProjects() {
    try {
      const res = await axios.get(`${API_URL}/api/projects`);
      setProjects((res.data.projects || []).map(normalizePlan));
    } catch {
      setProjects([]);
    }
  }

  function commit(nextPlan) {
    const finalPlan = normalizePlan(nextPlan);

    if (plan) {
      setHistory((items) => [...items, clone(plan)].slice(-40));
    }

    setFuture([]);
    setPlan(finalPlan);
  }

  async function generatePlan() {
    if (!prompt.trim()) {
      alert("Please enter house/building requirements.");
      return;
    }

    setLoading(true);
    setSelected(null);
    setHistory([]);
    setFuture([]);

    try {
      const res = await axios.post(`${API_URL}/api/ai/generate-plan`, { prompt });

      if (res.data.ok) {
        setPlan(normalizePlan(res.data.plan));
        setActiveFloor(0);
        setViewMode("2d");
        setZoom(1);
        setStagePosition({ x: 0, y: 0 });
      }
    } catch {
      alert("Backend is not reachable. Start NexaCAD backend on port 5100.");
    } finally {
      setLoading(false);
    }
  }

  async function applyAIEdit() {
    if (!plan) {
      alert("Generate or start a plan first.");
      return;
    }

    if (!aiCommand.trim()) {
      alert("Enter an AI edit command.");
      return;
    }

    setCommandLoading(true);

    try {
      const res = await axios.post(`${API_URL}/api/ai/edit-plan`, {
        plan,
        command: aiCommand
      });

      if (res.data.ok) {
        commit(res.data.plan);
        setAiCommand("");
        setViewMode("2d");
      }
    } catch {
      alert("AI edit failed. Check backend.");
    } finally {
      setCommandLoading(false);
    }
  }

  async function saveProject() {
    if (!plan) {
      alert("Generate or start a project first.");
      return;
    }

    if (collisionWarnings.length > 0) {
      const ok = window.confirm(
        `This project has ${collisionWarnings.length} room overlap warning(s). Save anyway?`
      );
      if (!ok) return;
    }

    setSaving(true);

    try {
      const res = await axios.post(`${API_URL}/api/projects`, {
        project: normalizePlan(plan)
      });

      if (res.data.ok) {
        setPlan(normalizePlan(res.data.project));
        await loadProjects();
        alert("Project saved.");
      }
    } catch {
      alert("Project could not be saved.");
    } finally {
      setSaving(false);
    }
  }

  async function deleteProject(id) {
    const ok = window.confirm("Delete this project?");
    if (!ok) return;

    try {
      await axios.delete(`${API_URL}/api/projects/${id}`);
      await loadProjects();

      if (plan?.id === id) {
        setPlan(null);
        setViewMode("dashboard");
      }
    } catch {
      alert("Could not delete project.");
    }
  }

  function loadProject(project) {
    setPlan(normalizePlan(project));
    setSelected(null);
    setActiveFloor(0);
    setViewMode("2d");
    setHistory([]);
    setFuture([]);
    setZoom(1);
    setStagePosition({ x: 0, y: 0 });
  }

  function createStarter(template) {
    const starter = createStarterPlan(template);
    setPlan(starter);
    setPrompt(`Starter generated: ${template.title}`);
    setSelected(null);
    setActiveFloor(0);
    setViewMode("2d");
    setHistory([]);
    setFuture([]);
    setZoom(1);
    setStagePosition({ x: 0, y: 0 });
  }

  function undo() {
    if (history.length === 0 || !plan) return;

    const previous = history[history.length - 1];
    setHistory((items) => items.slice(0, -1));
    setFuture((items) => [clone(plan), ...items].slice(0, 40));
    setPlan(normalizePlan(previous));
  }

  function redo() {
    if (future.length === 0 || !plan) return;

    const next = future[0];
    setFuture((items) => items.slice(1));
    setHistory((items) => [...items, clone(plan)].slice(-40));
    setPlan(normalizePlan(next));
  }

  function updatePlanList(listName, id, updates) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));
    next[listName] = next[listName].map((item) =>
      item.id === id ? { ...item, ...updates } : item
    );

    commit(next);
  }

  function updateWallEndpoint(id, endpoint, position) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));

    next.walls = next.walls.map((wall) => {
      if (wall.id !== id) return wall;

      const start = {
        x: wall.x,
        y: wall.y
      };

      const end = {
        x: wall.x + wall.width,
        y: wall.y + wall.height
      };

      if (endpoint === "start") {
        return {
          ...wall,
          x: position.x,
          y: position.y,
          width: end.x - position.x,
          height: end.y - position.y
        };
      }

      return {
        ...wall,
        width: position.x - start.x,
        height: position.y - start.y
      };
    });

    commit(next);
  }

  function updateSelectedEntity(updates) {
    if (!plan || !selected) return;

    const listName =
      selected.type === "room"
        ? "rooms"
        : selected.type === "door"
        ? "doors"
        : selected.type === "window"
        ? "windows"
        : selected.type === "stairs"
        ? "stairs"
        : selected.type === "wall"
        ? "walls"
        : selected.type === "dimension"
        ? "dimensions"
        : selected.type === "text"
        ? "texts"
        : null;

    if (!listName) return;
    updatePlanList(listName, selected.id, updates);
  }

  function updateProjectInfo(projectInfo) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));
    next.projectInfo = {
      ...getDefaultProjectInfo(next),
      ...projectInfo
    };

    commit(next);
  }

  function toggleLayer(layerId) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));
    next.layers = next.layers.map((layer) =>
      layer.id === layerId ? { ...layer, visible: !layer.visible } : layer
    );

    commit(next);
  }

  function autoFixOverlaps() {
    if (!plan) {
      alert("Start or generate a project first.");
      return;
    }

    const next = normalizePlan(clone(plan));
    const scale = next.scale || 12;
    const gap = 2 * scale;
    const maxWidth = next.canvas?.width || next.plot.width * scale || 720;

    for (let floor = 0; floor < next.floors; floor += 1) {
      const rooms = next.rooms
        .filter((room) => room.floor === floor && room.type !== "terrace")
        .sort((a, b) => a.y - b.y || a.x - b.x);

      let cursorX = gap;
      let cursorY = gap;
      let rowHeight = 0;

      rooms.forEach((room) => {
        if (cursorX + room.width > maxWidth - gap) {
          cursorX = gap;
          cursorY += rowHeight + gap;
          rowHeight = 0;
        }

        room.x = cursorX;
        room.y = cursorY;

        cursorX += room.width + gap;
        rowHeight = Math.max(rowHeight, room.height);
      });
    }

    next.doors = next.doors.map((door) => {
      const room = next.rooms.find((item) => item.id === door.roomId);
      if (!room) return door;

      return {
        ...door,
        x: room.x + room.width / 2 - door.width / 2,
        y: room.y + room.height - door.height
      };
    });

    next.windows = next.windows.map((windowItem) => {
      const room = next.rooms.find((item) => item.id === windowItem.roomId);
      if (!room) return windowItem;

      return {
        ...windowItem,
        x: room.x + room.width - windowItem.width,
        y: room.y + room.height / 2 - windowItem.height / 2
      };
    });

    commit(next);
    setSelected(null);
    alert("Overlap auto-fix applied.");
  }

  function addRoom(position = { x: 48, y: 48 }) {
    if (!plan) return;

    const scale = plan.scale || 12;
    const next = normalizePlan(clone(plan));

    const item = {
      id: uuidv4(),
      name: "New Room",
      type: "room",
      floor: activeFloor,
      x: position.x,
      y: position.y,
      width: 12 * scale,
      height: 12 * scale,
      color: "#e0e7ff",
      wallThickness: 6,
      layer: "architecture",
      locked: false
    };

    next.rooms.push(item);
    commit(next);
    setSelected({ type: "room", id: item.id });
  }

  function addCurvedWall(position = { x: 120, y: 120 }) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));

    const item = {
      id: uuidv4(),
      floor: activeFloor,
      x: position.x,
      y: position.y,
      radius: 72,
      startAngle: 205,
      endAngle: 335,
      thickness: 8,
      height: 2.1,
      type: "curved-wall",
      name: "Curved Gallery Wall",
      layer: "curves"
    };

    next.curvedWalls.push(item);
    commit(next);
    setSelected({ type: "curvedWall", id: item.id });
  }

  function addWall(position = { x: 60, y: 60 }) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));

    const item = {
      id: uuidv4(),
      floor: activeFloor,
      x: position.x,
      y: position.y,
      width: 120,
      height: 0,
      thickness: 8,
      type: "wall",
      layer: "walls"
    };

    next.walls.push(item);
    commit(next);
    setSelected({ type: "wall", id: item.id });
  }

  function addLineObject(kind, payload) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));

    if (kind === "wall") {
      const item = {
        id: uuidv4(),
        floor: activeFloor,
        x: payload.x,
        y: payload.y,
        width: payload.width,
        height: payload.height,
        thickness: 8,
        type: "wall",
        layer: "walls"
      };

      next.walls.push(item);
      commit(next);
      setSelected({ type: "wall", id: item.id });
      return;
    }

    if (kind === "dimension") {
      const feet =
        payload.label ||
        `${calculateDistanceFeet(payload.width, payload.height || 0, plan.scale || 12)} ft`;

      const item = {
        id: uuidv4(),
        floor: activeFloor,
        x: payload.x,
        y: payload.y,
        width: payload.width,
        height: payload.height || 0,
        label: feet,
        layer: "dimensions"
      };

      next.dimensions.push(item);
      commit(next);
      setSelected({ type: "dimension", id: item.id });
    }
  }

  function findSelectedRoomOrFirstRoom(next) {
    if (selected?.type === "room") {
      const selectedRoom = next.rooms.find((item) => item.id === selected.id);
      if (selectedRoom) return selectedRoom;
    }

    return next.rooms.find((item) => item.floor === activeFloor) || null;
  }

  function addDoor(position = null) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));
    const room = findSelectedRoomOrFirstRoom(next);

    const fallbackPoint = {
      x: room ? room.x + room.width / 2 - 18 : 80,
      y: room ? room.y + room.height - 8 : 80
    };

    const nearest = position ? findNearestWall(next, position, activeFloor) : null;
    const geometry = makeSnappedOpeningGeometry(
      "door",
      nearest,
      position || fallbackPoint
    );

    const item = {
      id: uuidv4(),
      roomId: room?.id || null,
      floor: activeFloor,
      x: geometry.x,
      y: geometry.y,
      width: geometry.width,
      height: geometry.height,
      type: "door",
      label: nearest ? "Door - Snapped to Wall" : "Door",
      layer: "openings"
    };

    next.doors.push(item);
    commit(next);
    setSelected({ type: "door", id: item.id });
  }

  function addWindow(position = null) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));
    const room = findSelectedRoomOrFirstRoom(next);

    const fallbackPoint = {
      x: room ? room.x + room.width - 8 : 90,
      y: room ? room.y + room.height / 2 - 20 : 90
    };

    const nearest = position ? findNearestWall(next, position, activeFloor) : null;
    const geometry = makeSnappedOpeningGeometry(
      "window",
      nearest,
      position || fallbackPoint
    );

    const item = {
      id: uuidv4(),
      roomId: room?.id || null,
      floor: activeFloor,
      x: geometry.x,
      y: geometry.y,
      width: geometry.width,
      height: geometry.height,
      type: "window",
      label: nearest ? "Window - Snapped to Wall" : "Window",
      layer: "openings"
    };

    next.windows.push(item);
    commit(next);
    setSelected({ type: "window", id: item.id });
  }

  function addStairs(position = { x: 80, y: 80 }) {
    if (!plan) return;

    const scale = plan.scale || 12;
    const next = normalizePlan(clone(plan));

    const item = {
      id: uuidv4(),
      floor: activeFloor,
      x: position.x,
      y: position.y,
      width: 10 * scale,
      height: 14 * scale,
      type: "straight-stair",
      name: "Stairs",
      layer: "stairs"
    };

    next.stairs.push(item);
    commit(next);
    setSelected({ type: "stairs", id: item.id });
  }

  function addDimension(position = { x: 80, y: 80 }) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));

    const item = {
      id: uuidv4(),
      floor: activeFloor,
      x: position.x,
      y: position.y,
      width: 120,
      height: 0,
      label: `${Math.round(120 / (plan.scale || 12))} ft`,
      layer: "dimensions"
    };

    next.dimensions.push(item);
    commit(next);
    setSelected({ type: "dimension", id: item.id });
  }

  function addText(position = { x: 80, y: 80 }) {
    if (!plan) return;

    const next = normalizePlan(clone(plan));

    const item = {
      id: uuidv4(),
      floor: activeFloor,
      x: position.x,
      y: position.y,
      text: "New Label",
      fontSize: 16,
      fontStyle: "bold",
      color: "#0f172a",
      layer: "text"
    };

    next.texts.push(item);
    commit(next);
    setSelected({ type: "text", id: item.id });
  }

  function onCanvasCommand(position) {
    if (activeTool === "room") addRoom(position);
    if (activeTool === "wall") addWall(position);
    if (activeTool === "door") addDoor(position);
    if (activeTool === "window") addWindow(position);
    if (activeTool === "stairs") addStairs(position);
    if (activeTool === "dimension") addDimension(position);
    if (activeTool === "text") addText(position);
  }

  function deleteSelected() {
    if (!plan || !selected) return;

    const next = normalizePlan(clone(plan));

    if (selected.type === "room") {
      next.rooms = next.rooms.filter((item) => item.id !== selected.id);
      next.doors = next.doors.filter((item) => item.roomId !== selected.id);
      next.windows = next.windows.filter((item) => item.roomId !== selected.id);
    }

    if (selected.type === "door") next.doors = next.doors.filter((item) => item.id !== selected.id);
    if (selected.type === "window") next.windows = next.windows.filter((item) => item.id !== selected.id);
    if (selected.type === "stairs") next.stairs = next.stairs.filter((item) => item.id !== selected.id);
    if (selected.type === "wall") next.walls = next.walls.filter((item) => item.id !== selected.id);
    if (selected.type === "furniture") next.furniture = next.furniture.filter((item) => item.id !== selected.id);
    if (selected.type === "electrical") next.electrical = next.electrical.filter((item) => item.id !== selected.id);
    if (selected.type === "plumbing") next.plumbing = next.plumbing.filter((item) => item.id !== selected.id);
    if (selected.type === "curvedWall") next.curvedWalls = next.curvedWalls.filter((item) => item.id !== selected.id);
    if (selected.type === "dimension") next.dimensions = next.dimensions.filter((item) => item.id !== selected.id);
    if (selected.type === "text") next.texts = next.texts.filter((item) => item.id !== selected.id);

    commit(next);
    setSelected(null);
  }

  function duplicateSelected() {
    if (!plan || !selected) return;

    const next = normalizePlan(clone(plan));

    const listName =
      selected.type === "room"
        ? "rooms"
        : selected.type === "door"
        ? "doors"
        : selected.type === "window"
        ? "windows"
        : selected.type === "stairs"
        ? "stairs"
        : selected.type === "wall"
        ? "walls"
        : selected.type === "dimension"
        ? "dimensions"
        : selected.type === "text"
        ? "texts"
        : null;

    if (!listName) return;

    const original = next[listName].find((item) => item.id === selected.id);
    if (!original) return;

    const copy = {
      ...clone(original),
      id: uuidv4(),
      x: original.x + 24,
      y: original.y + 24,
      name: original.name ? `${original.name} Copy` : original.name,
      text: original.text ? `${original.text} Copy` : original.text
    };

    next[listName].push(copy);
    commit(next);
    setSelected({ type: selected.type, id: copy.id });
  }

  function exportProjectJSON() {
    if (!plan) {
      alert("Generate or load a project first.");
      return;
    }

    const payload = {
      app: "NexaCAD AI Pro",
      version: "phase-12",
      exportedAt: new Date().toISOString(),
      project: normalizePlan(plan)
    };

    const blob = new Blob([JSON.stringify(payload, null, 2)], {
      type: "application/json"
    });

    const url = window.URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `${plan.title || "nexacad-project"}.json`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    window.URL.revokeObjectURL(url);
  }

  function importProjectJSON(file) {
    const reader = new FileReader();

    reader.onload = () => {
      try {
        const parsed = JSON.parse(String(reader.result || "{}"));
        const importedProject = parsed.project || parsed;

        if (!importedProject || !Array.isArray(importedProject.rooms)) {
          alert("Invalid NexaCAD project JSON.");
          return;
        }

        const normalized = normalizePlan({
          ...importedProject,
          id: importedProject.id || uuidv4(),
          title: importedProject.title || "Imported NexaCAD Project"
        });

        setPlan(normalized);
        setActiveFloor(0);
        setViewMode("2d");
        setSelected(null);
        setHistory([]);
        setFuture([]);
        setZoom(1);
        setStagePosition({ x: 0, y: 0 });

        alert("Project imported successfully.");
      } catch {
        alert("Could not import JSON file.");
      }
    };

    reader.readAsText(file);
  }

  const shellClass = fullscreenStudio ? "app-shell studio-fullscreen" : "app-shell";

  return (
    <div className={shellClass}>
      <header className="main-header">
        <div className="brand">
          <div className="brand-logo">
            <Building2 size={30} />
          </div>

          <div>
            <h1>NexaCAD AI Pro</h1>
            <p>AI Architect Studio + CAD Editor + 3D Preview</p>
          </div>
        </div>

        <div className="top-actions">
          <button
            className="studio-mode-btn"
            onClick={() => setViewMode("dashboard")}
            title="Dashboard"
          >
            <LayoutDashboard size={17} />
            Dashboard
          </button>

          <button
            className="studio-mode-btn"
            onClick={() => setFullscreenStudio((value) => !value)}
            title="Fullscreen Studio"
          >
            {fullscreenStudio ? <Minimize2 size={17} /> : <Maximize2 size={17} />}
            {fullscreenStudio ? "Exit Fullscreen" : "Fullscreen"}
          </button>

          <div className="status-pill">
            {backendStatus === "online" ? <Wifi size={16} /> : <WifiOff size={16} />}
            <span>
              Backend{" "}
              {backendStatus === "checking"
                ? "Checking"
                : backendStatus === "online"
                ? "Online"
                : "Offline"}
            </span>

            <button onClick={checkBackend}>
              <RefreshCw size={14} />
            </button>
          </div>
        </div>
      </header>

      <div className="main-layout">
        <aside className="left-panel">
          <AICommandPanel
            prompt={prompt}
            setPrompt={setPrompt}
            onGenerate={generatePlan}
            aiCommand={aiCommand}
            setAiCommand={setAiCommand}
            onEditPlan={applyAIEdit}
            loading={loading}
            commandLoading={commandLoading}
          />

          <section className="template-panel">
            <div className="panel-heading">
              <Sparkles size={18} />
              <span>Quick AI Templates</span>
            </div>

            <div className="template-grid">
              {QUICK_TEMPLATES.map((template) => (
                <button
                  key={template.id}
                  className="template-card"
                  onClick={() => setPrompt(template.prompt)}
                >
                  <strong>{template.title}</strong>
                  <span>{template.subtitle}</span>
                </button>
              ))}
            </div>
          </section>

          <ProjectSettingsPanel
            plan={plan}
            onUpdateProjectInfo={updateProjectInfo}
          />

          <ProjectBackupPanel
            plan={plan}
            collisionWarnings={collisionWarnings}
            onExportJSON={exportProjectJSON}
            onImportJSON={importProjectJSON}
          />

          <div className="autosave-card">
            <div>
              <strong>Autosave</strong>
              <span>{autosaveStatus}</span>
            </div>

            <button onClick={clearAutosave}>
              <RotateCcw size={15} />
              Clear
            </button>
          </div>

          <ProjectPanel
            projects={projects}
            onLoadProject={loadProject}
            onDeleteProject={deleteProject}
          />
        </aside>

        <CADToolbar
          activeTool={activeTool}
          setActiveTool={setActiveTool}
          onDuplicate={duplicateSelected}
          onDelete={deleteSelected}
          onUndo={undo}
          onRedo={redo}
          onZoomIn={() => setZoom((value) => Math.min(2.2, value + 0.1))}
          onZoomOut={() => setZoom((value) => Math.max(0.45, value - 0.1))}
          onSave={saveProject}
          onPNG={() => exportStagePNG(stageRef, plan)}
          onPDF={() => exportPlanPDF(stageRef, plan, activeFloor)}
          onDXF={() => exportPlanDXF(plan)}
          canEdit={Boolean(selected)}
        />

        <main className="workspace">
          {viewMode === "dashboard" ? (
            <section className="dashboard-screen">
              <div className="dashboard-hero">
                <div>
                  <span className="dashboard-badge">NexaCAD AI Pro Phase 12</span>
                  <h2>AI Architecture Studio</h2>
                  <p>
                    Start from a professional template, generate a plan with AI, edit walls
                    with endpoint handles, preview in 3D, export PDF/PNG/DXF and BOQ.
                  </p>

                  <div className="dashboard-actions">
                    <button onClick={() => setViewMode("2d")}>
                      <DraftingCompass size={18} />
                      Open Studio
                    </button>

                    <button onClick={() => setFullscreenStudio(true)}>
                      <Maximize2 size={18} />
                      Fullscreen Studio
                    </button>
                  </div>
                </div>

                <div className="dashboard-orb">
                  <Building2 size={58} />
                  <span>AI CAD</span>
                </div>
              </div>

              <div className="starter-grid">
                {STARTER_TEMPLATES.map((template) => (
                  <button
                    key={template.id}
                    className="starter-card"
                    onClick={() => createStarter(template)}
                  >
                    <strong>{template.title}</strong>
                    <span>{template.subtitle}</span>
                    <small>
                      {template.width} x {template.length} ft • {template.floors} floors
                    </small>
                  </button>
                ))}
              </div>

              <div className="dashboard-status-grid">
                <div>
                  <span>Current Project</span>
                  <strong>{plan?.title || "No project loaded"}</strong>
                </div>

                <div>
                  <span>Backend</span>
                  <strong>{backendStatus}</strong>
                </div>

                <div>
                  <span>Safety</span>
                  <strong>
                    {collisionWarnings.length > 0
                      ? `${collisionWarnings.length} overlap warning(s)`
                      : "No warnings"}
                  </strong>
                </div>
              </div>
            </section>
          ) : (
            <>
              <section className="workspace-hero">
                <div className="workspace-hero-main">
                  <small>ACTIVE PROJECT</small>
                  <h2>{plan?.title || "Start a new AI architectural project"}</h2>
                  <p>
                    {plan
                      ? `${stats.plot} • ${stats.floors} floor(s) • ${stats.rooms} room objects`
                      : "Use AI prompt, starter dashboard, or a quick template to generate a plan."}
                  </p>
                </div>

                <div className="workspace-hero-grid">
                  <div className="hero-mini-card">
                    <span>Selection</span>
                    <strong>{selectedLabel}</strong>
                  </div>

                  <div className="hero-mini-card">
                    <span>Current Floor Area</span>
                    <strong>{stats.floorArea} sq ft</strong>
                  </div>

                  <div className="hero-mini-card">
                    <span>Layers</span>
                    <strong>{stats.layers}</strong>
                  </div>

                  <div
                    className={
                      collisionWarnings.length > 0
                        ? "hero-mini-card warning"
                        : "hero-mini-card"
                    }
                  >
                    <span>Safety</span>
                    <strong>
                      {collisionWarnings.length > 0
                        ? `${collisionWarnings.length} warning(s)`
                        : "No overlaps"}
                    </strong>
                  </div>
                </div>
              </section>

              <section className="stats-row">
                <div>
                  <Ruler size={20} />
                  <span>Plot</span>
                  <strong>{stats.plot}</strong>
                </div>

                <div>
                  <Home size={20} />
                  <span>Floors</span>
                  <strong>{stats.floors}</strong>
                </div>

                <div>
                  <Boxes size={20} />
                  <span>Rooms</span>
                  <strong>{stats.rooms}</strong>
                </div>

                <div>
                  <Layers size={20} />
                  <span>Floor Area</span>
                  <strong>{stats.floorArea || "-"} sq ft</strong>
                </div>
              </section>

              <section className="floor-tabs">
                {plan ? (
                  Array.from({ length: plan.floors }).map((_, index) => (
                    <button
                      key={index}
                      className={activeFloor === index ? "active" : ""}
                      onClick={() => {
                        setActiveFloor(index);
                        setSelected(null);
                      }}
                    >
                      {index === 0 ? "Ground Floor" : `Floor ${index}`}
                    </button>
                  ))
                ) : (
                  <button className="active">No Floor</button>
                )}

                <button
                  className={viewMode === "2d" ? "active view-toggle" : "view-toggle"}
                  onClick={() => setViewMode("2d")}
                >
                  <DraftingCompass size={15} />
                  2D CAD
                </button>

                <button
                  className={viewMode === "3d" ? "active view-toggle" : "view-toggle"}
                  onClick={() => setViewMode("3d")}
                >
                  <Box size={15} />
                  3D Preview
                </button>

                <button
                  className="view-toggle auto-fix-btn"
                  onClick={autoFixOverlaps}
                  disabled={!plan}
                >
                  <Wand2 size={15} />
                  Auto-Fix Overlaps
                </button>

                <button
                  className="view-toggle export-csv"
                  onClick={() => exportBOQCSV(plan)}
                  disabled={!plan}
                >
                  <FileSpreadsheet size={15} />
                  BOQ CSV
                </button>

                <span className="zoom-label">Zoom: {Math.round(zoom * 100)}%</span>
                <span className="zoom-label">
                  Tool: <strong>{activeTool}</strong>
                </span>
                <span className="saving-label">{saving ? "Saving..." : ""}</span>

                {collisionWarnings.length > 0 && (
                  <span className="warning-chip">
                    <AlertTriangle size={14} />
                    {collisionWarnings.length} overlap warning(s)
                  </span>
                )}
              </section>

              {viewMode === "2d" ? (
                <CADCanvas
                  plan={plan}
                  activeFloor={activeFloor}
                  activeTool={activeTool}
                  selected={selected}
                  setSelected={setSelected}
                  stageRef={stageRef}
                  zoom={zoom}
                  stagePosition={stagePosition}
                  setStagePosition={setStagePosition}
                  onMoveRoom={(id, updates) => updatePlanList("rooms", id, updates)}
                  onResizeRoom={(id, updates) => updatePlanList("rooms", id, updates)}
                  onMoveDoor={(id, updates) => updatePlanList("doors", id, updates)}
                  onMoveWindow={(id, updates) => updatePlanList("windows", id, updates)}
                  onMoveStair={(id, updates) => updatePlanList("stairs", id, updates)}
                  onMoveWall={(id, updates) => updatePlanList("walls", id, updates)}
                  onResizeWallEndpoint={updateWallEndpoint}
                  onMoveDimension={(id, updates) =>
                    updatePlanList("dimensions", id, updates)
                  }
                  onMoveText={(id, updates) => updatePlanList("texts", id, updates)}
                  onCanvasCommand={onCanvasCommand}
                  onCreateLineObject={addLineObject}
                />
              ) : (
                <ThreeDPreview plan={plan} activeFloor={activeFloor} />
              )}
            </>
          )}
        </main>

        <div className="right-stack">
          <InspectorPanel
            plan={plan}
            selected={selected}
            updateSelectedEntity={updateSelectedEntity}
            toggleLayer={toggleLayer}
          />

          <RoomSchedulePanel
            plan={plan}
            activeFloor={activeFloor}
            selected={selected}
            setSelected={setSelected}
            setActiveFloor={setActiveFloor}
          />

          <EstimatePanel plan={plan} />
        </div>
      </div>
    </div>
  );
}