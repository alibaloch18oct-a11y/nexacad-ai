function calculateDistanceFeet(width, height, scale) {
  const distance = Math.sqrt(width * width + height * height);
  return Math.max(1, Math.round(distance / scale));
}

function distancePointToSegment(point, wall) {
  const x1 = wall.x;
  const y1 = wall.y;
  const x2 = wall.x + wall.width;
  const y2 = wall.y + wall.height;
  const dx = x2 - x1;
  const dy = y2 - y1;

  if (dx === 0 && dy === 0) {
    return {
      distance: Math.hypot(point.x - x1, point.y - y1),
      x: x1,
      y: y1,
      angle: 0
    };
  }

  const t = Math.max(
    0,
    Math.min(1, ((point.x - x1) * dx + (point.y - y1) * dy) / (dx * dx + dy * dy))
  );

  const x = x1 + t * dx;
  const y = y1 + t * dy;

  return {
    distance: Math.hypot(point.x - x, point.y - y),
    x,
    y,
    angle: Math.atan2(dy, dx)
  };
}

function findNearestWall(plan, point, activeFloor) {
  const walls = (plan.walls || []).filter((wall) => wall.floor === activeFloor);
  if (walls.length === 0) return null;

  let best = null;

  walls.forEach((wall) => {
    const result = distancePointToSegment(point, wall);
    if (!best || result.distance < best.distance) {
      best = { wall, ...result };
    }
  });

  if (!best || best.distance > 40) return null;
  return best;
}

function makeSnappedOpeningGeometry(kind, nearest, fallbackPoint) {
  if (!nearest) {
    if (kind === "door") {
      return { x: fallbackPoint.x, y: fallbackPoint.y, width: 36, height: 8 };
    }
    return { x: fallbackPoint.x, y: fallbackPoint.y, width: 8, height: 40 };
  }

  const horizontal =
    Math.abs(Math.cos(nearest.angle)) >= Math.abs(Math.sin(nearest.angle));

  if (kind === "door") {
    return horizontal
      ? { x: nearest.x - 18, y: nearest.y - 4, width: 36, height: 8 }
      : { x: nearest.x - 4, y: nearest.y - 18, width: 8, height: 36 };
  }

  return horizontal
    ? { x: nearest.x - 22, y: nearest.y - 4, width: 44, height: 8 }
    : { x: nearest.x - 4, y: nearest.y - 22, width: 8, height: 44 };
}

function roomsOverlap(a, b) {
  return !(
    a.x + a.width <= b.x ||
    b.x + b.width <= a.x ||
    a.y + a.height <= b.y ||
    b.y + b.height <= a.y
  );
}

function detectCollisionWarnings(plan) {
  if (!plan) return [];

  const warnings = [];
  const rooms = Array.isArray(plan.rooms) ? plan.rooms : [];

  for (let i = 0; i < rooms.length; i += 1) {
    for (let j = i + 1; j < rooms.length; j += 1) {
      const a = rooms[i];
      const b = rooms[j];

      if (a.floor !== b.floor) continue;
      if (["terrace"].includes(a.type) || ["terrace"].includes(b.type)) continue;

      if (roomsOverlap(a, b)) {
        warnings.push({
          id: `${a.id}-${b.id}`,
          floor: a.floor,
          floorLabel: a.floor === 0 ? "Ground Floor" : `Floor ${a.floor}`,
          roomA: a.name,
          roomB: b.name
        });
      }
    }
  }

  return warnings;
}

function resolveSelectedLabel(plan, selected) {
  if (!plan || !selected) return "Nothing selected";

  const map = {
    room: plan.rooms,
    door: plan.doors,
    window: plan.windows,
    stairs: plan.stairs,
    wall: plan.walls,
    dimension: plan.dimensions,
    text: plan.texts
  };

  const list = map[selected.type] || [];
  const item = list.find((entry) => entry.id === selected.id);

  if (!item) return "Nothing selected";
  if (selected.type === "room") return `Room • ${item.name}`;
  if (selected.type === "wall") return "Wall selected";
  if (selected.type === "stairs") return item.name || "Stairs selected";
  if (selected.type === "text") return `Text • ${item.text}`;

  return `${selected.type.charAt(0).toUpperCase()}${selected.type.slice(1)} selected`;
}

